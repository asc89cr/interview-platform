# ─────────────────────────────────────────────────────────────────────────────
# Interview Platform — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Managed PostgreSQL (Neon or Supabase) — includes PgBouncer pooling.
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Managed Redis (Upstash) — serverless, TTL 60s for WebSocket reconnect hold.
# Format: redis://:PASSWORD@HOST:PORT/0  (or rediss:// for TLS)
REDIS_URL=

# ── AI / STT ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# ── Payments ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Set to your Vercel URL in production.
# Example: https://your-app.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=http://localhost:3000

# ── AWS / S3 ──────────────────────────────────────────────────────────────────
# IAM user with least-privilege access (see infra/s3-policy.json).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=interview-platform-files
CLOUDFRONT_DOMAIN=

# ── Error Tracking ────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────────────
# Desktop Client (Vite / Electron) — set in desktop-client/.env
# ─────────────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://your-backend.railway.app
VITE_SENTRY_DSN=
